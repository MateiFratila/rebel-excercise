DATABASE_URL=postgresql+asyncpg://faq:replace-me@postgres:5432/faq
POSTGRES_DB=faq
POSTGRES_USER=faq
POSTGRES_PASSWORD=replace-me
ENVIRONMENT=local
OPENAI_API_KEY=replace-with-openai-api-key
SHARED_PASSWORD_HASH=replace-with-argon2id-hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-5.4-mini
LOCAL_SIMILARITY_THRESHOLD=0.84
LOCAL_SIMILARITY_MARGIN=0.08
SCOPE_CONFIDENCE_THRESHOLD=0.75
SESSION_COOKIE_NAME=faq_session
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=604800
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
EMBEDDING_BATCH_SIZE=64
JOB_POLL_INTERVAL_SECONDS=5
JOB_STALE_AFTER_SECONDS=300
