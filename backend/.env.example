DATABASE_URL=postgresql+asyncpg://faq:faq@localhost:5432/faq
ENVIRONMENT=local
OPENAI_API_KEY=replace-with-openai-api-key
SHARED_PASSWORD_HASH=replace-with-argon2id-hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
LOCAL_SIMILARITY_THRESHOLD=0.84
LOCAL_SIMILARITY_MARGIN=0.08
SCOPE_CONFIDENCE_THRESHOLD=0.75
SESSION_COOKIE_NAME=faq_session
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=604800
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
EMBEDDING_BATCH_SIZE=64
EMBEDDING_RUNNER_ENABLED=true
JOB_POLL_INTERVAL_SECONDS=5
JOB_STALE_AFTER_SECONDS=300
LOG_LEVEL=INFO
